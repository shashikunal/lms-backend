# Server Configuration
PORT=8000
NODE_ENV=development
ORIGIN=http://localhost:3000

# Database (MongoDB Atlas connection string)
DB_URI=mongodb+srv://<username>:<password>@cluster0.example.mongodb.net/lms?retryWrites=true&w=majority

# Cache (Redis / Upstash Redis connection string)
REDIS_URL=rediss://default:<password>@<host>:<port>

# JWT Authentication
ACCESS_TOKEN=your_super_secret_access_token_32_characters_long
REFRESH_TOKEN=your_super_secret_refresh_token_32_characters_long
ACCESS_TOKEN_EXPIRE=5
REFRESH_TOKEN_EXPIRE=3
ACTIVATION_TOKEN_SECRET=your_super_secret_activation_token

# Cloudinary (Media upload storage)
CLOUD_NAME=your_cloudinary_cloud_name
CLOUDINARY_API=your_cloudinary_api_key
CLOUDINARY_SECRET=your_cloudinary_api_secret

